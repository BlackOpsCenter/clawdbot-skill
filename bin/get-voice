#!/usr/bin/env bash
set -euo pipefail

# Get brand voice profile for a site
# Usage: get-voice [--domain example.com | --site-id abc123]

DOMAIN=""
SITE_ID=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --domain)
      DOMAIN="$2"
      shift 2
      ;;
    --site-id)
      SITE_ID="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: get-voice [OPTIONS]"
      echo ""
      echo "Get brand voice profile for a site."
      echo ""
      echo "Options:"
      echo "  --domain DOMAIN       Site domain (e.g., benenewton.com)"
      echo "  --site-id ID          Site ID (alternative to --domain)"
      echo "  -h, --help            Show this help message"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# If domain provided, get site ID first
if [[ -n "$DOMAIN" && -z "$SITE_ID" ]]; then
  SITES_JSON=$(curl -s -X GET \
    -H "Authorization: Bearer ${BLACKOPS_API_TOKEN}" \
    -H "Content-Type: application/json" \
    "${BLACKOPS_BASE_URL}/api/ext/sites")
  
  SITE_ID=$(echo "$SITES_JSON" | jq -r ".sites[] | select(.domain == \"$DOMAIN\") | .id")
  
  if [[ -z "$SITE_ID" || "$SITE_ID" == "null" ]]; then
    echo "Error: Site not found for domain: $DOMAIN" >&2
    exit 1
  fi
fi

# Validate we have a site ID
if [[ -z "$SITE_ID" ]]; then
  echo "Error: --domain or --site-id required" >&2
  exit 1
fi

# Get voice profile
curl -s -X GET \
  -H "Authorization: Bearer ${BLACKOPS_API_TOKEN}" \
  -H "Content-Type: application/json" \
  "${BLACKOPS_BASE_URL}/api/ext/sites/${SITE_ID}/voice"
