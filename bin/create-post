#!/usr/bin/env bash
set -euo pipefail

# Create a new post

TITLE=""
CONTENT=""
EXCERPT=""
TAGS=""
STATUS="draft"
DOMAIN=""
SITE_ID=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)
      TITLE="$2"
      shift 2
      ;;
    --content)
      CONTENT="$2"
      shift 2
      ;;
    --excerpt)
      EXCERPT="$2"
      shift 2
      ;;
    --tags)
      TAGS="$2"
      shift 2
      ;;
    --status)
      STATUS="$2"
      shift 2
      ;;
    --domain)
      DOMAIN="$2"
      shift 2
      ;;
    --site-id)
      SITE_ID="$2"
      shift 2
      ;;
    --help|-h)
      cat <<EOF
Create a new blog post

Usage:
  blackops-center create-post --title "..." --content "..." [options]

Required:
  --title <title>       Post title
  --content <content>   Post content (markdown)

Optional:
  --excerpt <text>      Post excerpt/description
  --tags <tags>         Comma-separated tags (e.g., "ai,automation,tools")
  --status <status>     Post status (draft or published, default: draft)
  --domain <domain>     Specify site by domain (e.g., example.com)
  --site-id <id>        Specify site by ID

Examples:
  blackops-center create-post \\
    --title "My Post" \\
    --content "# Hello\n\nThis is my post content."

  blackops-center create-post \\
    --title "Published Post" \\
    --content "Content here" \\
    --status published \\
    --tags "ai,automation"
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$TITLE" ]] || [[ -z "$CONTENT" ]]; then
  echo "Error: --title and --content are required" >&2
  echo "Run 'blackops-center create-post --help' for usage" >&2
  exit 1
fi

# Build JSON payload
PAYLOAD=$(jq -n \
  --arg title "$TITLE" \
  --arg content "$CONTENT" \
  --arg excerpt "$EXCERPT" \
  --arg status "$STATUS" \
  --arg tags "$TAGS" \
  --arg domain "$DOMAIN" \
  --arg site_id "$SITE_ID" \
  '{
    title: $title,
    content: $content,
    excerpt: $excerpt,
    status: $status,
    tags: ($tags | split(",") | map(select(length > 0)))
  } + (if $domain != "" then {domain: $domain} else {} end)
    + (if $site_id != "" then {site_id: $site_id} else {} end)')

RESPONSE=$(curl -s -X POST \
  -H "Authorization: Bearer ${BLACKOPS_API_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" \
  "${BLACKOPS_BASE_URL}/api/ext/posts")

# Extract preview URL components from response
POST_SLUG=$(echo "$RESPONSE" | jq -r '.post.slug // empty')
PREVIEW_TOKEN=$(echo "$RESPONSE" | jq -r '.post.preview_token // empty')
SITE_DOMAIN=$(echo "$RESPONSE" | jq -r '.site.name // empty')
POST_STATUS=$(echo "$RESPONSE" | jq -r '.post.status // empty')

# Output the full JSON response
echo "$RESPONSE"

# If we have preview token and slug, output a human-readable preview link
if [[ -n "$POST_SLUG" ]] && [[ -n "$PREVIEW_TOKEN" ]]; then
  # Determine the domain to use
  PREVIEW_DOMAIN=""
  if [[ -n "$DOMAIN" ]]; then
    PREVIEW_DOMAIN="$DOMAIN"
  else
    # Extract domain from the response site info or use default
    PREVIEW_DOMAIN=$(echo "$RESPONSE" | jq -r '.site.domain // empty')
    if [[ -z "$PREVIEW_DOMAIN" ]]; then
      PREVIEW_DOMAIN="${BLACKOPS_BASE_URL#https://}"
      PREVIEW_DOMAIN="${PREVIEW_DOMAIN#http://}"
    fi
  fi
  
  # Construct preview URL (format: /blog/{slug}?preview={token})
  PREVIEW_URL="https://${PREVIEW_DOMAIN}/blog/${POST_SLUG}?preview=${PREVIEW_TOKEN}"
  
  # Also show live URL for published posts
  LIVE_URL="https://${PREVIEW_DOMAIN}/blog/${POST_SLUG}"
  
  echo "" >&2
  if [[ "$POST_STATUS" == "published" ]]; then
    echo "✓ Post created: $POST_STATUS" >&2
    echo "Live URL: $LIVE_URL" >&2
  else
    echo "✓ Post created: $POST_STATUS" >&2
    echo "Preview: $PREVIEW_URL" >&2
  fi
fi
