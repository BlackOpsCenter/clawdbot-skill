#!/usr/bin/env bash
set -euo pipefail

# BlackOps Center CLI
# Main entry point for all commands

# Resolve symlinks to find the real script location
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ $SCRIPT_PATH != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SKILL_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CONFIG_FILE="${SKILL_DIR}/config.yaml"

# Load config
if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Error: config.yaml not found" >&2
  echo "Create ${CONFIG_FILE} with your api_token and base_url" >&2
  exit 1
fi

# Parse YAML (simple grep-based approach for these specific keys)
API_TOKEN=$(grep '^api_token:' "$CONFIG_FILE" | sed 's/^api_token:[[:space:]]*//; s/^"//; s/"$//' | tr -d '\n\r')
BASE_URL=$(grep '^base_url:' "$CONFIG_FILE" | sed 's/^base_url:[[:space:]]*//; s/^"//; s/"$//' | tr -d '\n\r')
DEFAULT_SITE_ID=$(grep '^default_site_id:' "$CONFIG_FILE" | sed 's/^default_site_id:[[:space:]]*//; s/^"//; s/"$//' | tr -d '\n\r' || true)
DEFAULT_DOMAIN=$(grep '^default_domain:' "$CONFIG_FILE" | sed 's/^default_domain:[[:space:]]*//; s/^"//; s/"$//' | tr -d '\n\r' || true)

if [[ -z "$API_TOKEN" ]]; then
  echo "Error: api_token not set in config.yaml" >&2
  exit 1
fi

if [[ -z "$BASE_URL" ]]; then
  BASE_URL="https://blackopscenter.com"
fi

# Export for subcommands
export BLACKOPS_API_TOKEN="$API_TOKEN"
export BLACKOPS_BASE_URL="$BASE_URL"
export BLACKOPS_DEFAULT_SITE_ID="$DEFAULT_SITE_ID"
export BLACKOPS_DEFAULT_DOMAIN="$DEFAULT_DOMAIN"

# Route to subcommand
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  list-sites)
    exec "${SKILL_DIR}/bin/list-sites" "$@"
    ;;
  list-posts)
    exec "${SKILL_DIR}/bin/list-posts" "$@"
    ;;
  get-post)
    exec "${SKILL_DIR}/bin/get-post" "$@"
    ;;
  create-post)
    exec "${SKILL_DIR}/bin/create-post" "$@"
    ;;
  update-post)
    exec "${SKILL_DIR}/bin/update-post" "$@"
    ;;
  delete-post)
    exec "${SKILL_DIR}/bin/delete-post" "$@"
    ;;
  generate-hero)
    exec "${SKILL_DIR}/bin/generate-hero" "$@"
    ;;
  update-seo)
    exec "${SKILL_DIR}/bin/update-seo" "$@"
    ;;
  manage-tags)
    exec "${SKILL_DIR}/bin/manage-tags" "$@"
    ;;
  send-tweet)
    exec "${SKILL_DIR}/bin/send-tweet" "$@"
    ;;
  reply-tweet)
    exec "${SKILL_DIR}/bin/reply-tweet" "$@"
    ;;
  search-tweets)
    exec "${SKILL_DIR}/bin/search-tweets" "$@"
    ;;
  delete-tweet)
    exec "${SKILL_DIR}/bin/delete-tweet" "$@"
    ;;
  list-scheduled-tweets)
    exec "${SKILL_DIR}/bin/list-scheduled-tweets" "$@"
    ;;
  delete-scheduled-tweet)
    exec "${SKILL_DIR}/bin/delete-scheduled-tweet" "$@"
    ;;
  help|--help|-h)
    cat <<EOF
BlackOps Center CLI

Usage:
  blackops-center <command> [options]

Content Commands:
  list-sites                List all sites you have access to (via API)
  list-posts                List posts for your site
  get-post <id>             Get a specific post
  create-post               Create a new post
  update-post <id>          Update an existing post
  delete-post <id>          Delete a post

Advanced Features:
  generate-hero             Generate AI hero image for a post
  update-seo                Update SEO metadata (title, description, keywords)
  manage-tags               Manage post tags (add, remove, replace, list)

Twitter Commands:
  send-tweet                Send a tweet or thread to Twitter
  reply-tweet               Reply to a tweet on Twitter
  search-tweets             Search for tweets (tracks usage quota)
  delete-tweet              Delete a posted tweet from Twitter
  list-scheduled-tweets     List all scheduled tweets with IDs and status
  delete-scheduled-tweet    Delete a scheduled tweet by ID

Examples:
  blackops-center list-posts --status draft --domain example.com
  blackops-center create-post --title "My Post" --content "Content here"
  blackops-center update-post abc123 --status published
  blackops-center generate-hero --post-id abc123 --style modern
  blackops-center update-seo --post-id abc123 --title "SEO Title"
  blackops-center manage-tags --post-id abc123 --action add --tags "ai,automation"
  blackops-center send-tweet --text "Hello from OpenClaw"
  blackops-center reply-tweet --tweet-url "https://x.com/user/status/123" --text "Great point!"
  blackops-center search-tweets --query "AI agents min_faves:5" --max-results 10
  blackops-center delete-tweet --tweet-id 2021371957497717136
  blackops-center list-scheduled-tweets
  blackops-center delete-scheduled-tweet --id abc123xyz

Run 'blackops-center <command> --help' for command-specific help.
EOF
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    echo "Run 'blackops-center help' for usage." >&2
    exit 1
    ;;
esac
