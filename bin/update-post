#!/usr/bin/env bash
set -euo pipefail

# Update an existing post

if [[ $# -eq 0 ]] || [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
  cat <<EOF
Update an existing blog post

Usage:
  blackops-center update-post <post-id> [options]

Options:
  --title <title>           Update title
  --content <content>       Update content
  --excerpt <text>          Update excerpt
  --tags <tags>             Update tags (comma-separated)
  --status <status>         Update status (draft or published)
  --featured-image <url>    Update featured image URL

Examples:
  # Publish a draft
  blackops-center update-post abc123 --status published

  # Update title and content
  blackops-center update-post abc123 \\
    --title "New Title" \\
    --content "New content here"

  # Unpublish back to draft
  blackops-center update-post abc123 --status draft
EOF
  exit 0
fi

POST_ID="$1"
shift

# Build JSON payload dynamically based on provided flags
JSON_PARTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)
      JSON_PARTS+=("\"title\": $(jq -n --arg v "$2" '$v')")
      shift 2
      ;;
    --content)
      JSON_PARTS+=("\"content\": $(jq -n --arg v "$2" '$v')")
      shift 2
      ;;
    --excerpt)
      JSON_PARTS+=("\"excerpt\": $(jq -n --arg v "$2" '$v')")
      shift 2
      ;;
    --tags)
      TAGS_JSON=$(jq -n --arg v "$2" '$v | split(",") | map(select(length > 0))')
      JSON_PARTS+=("\"tags\": ${TAGS_JSON}")
      shift 2
      ;;
    --status)
      JSON_PARTS+=("\"status\": $(jq -n --arg v "$2" '$v')")
      shift 2
      ;;
    --featured-image)
      JSON_PARTS+=("\"featured_image\": $(jq -n --arg v "$2" '$v')")
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [[ ${#JSON_PARTS[@]} -eq 0 ]]; then
  echo "Error: At least one field must be updated" >&2
  echo "Run 'blackops-center update-post --help' for usage" >&2
  exit 1
fi

# Join JSON parts
JSON_BODY="{$(IFS=,; echo "${JSON_PARTS[*]}")}"

# Add site_id to URL if available
if [[ -n "${BLACKOPS_DEFAULT_SITE_ID:-}" ]]; then
  API_URL="${BLACKOPS_BASE_URL}/api/ext/posts/${POST_ID}?site_id=${BLACKOPS_DEFAULT_SITE_ID}"
else
  API_URL="${BLACKOPS_BASE_URL}/api/ext/posts/${POST_ID}"
fi

RESPONSE=$(curl -s -X PUT \
  -H "Authorization: Bearer ${BLACKOPS_API_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$JSON_BODY" \
  "$API_URL")

# Extract components from response
POST_SLUG=$(echo "$RESPONSE" | jq -r '.slug // .post.slug // empty')
POST_STATUS=$(echo "$RESPONSE" | jq -r '.status // .post.status // empty')
PREVIEW_TOKEN=$(echo "$RESPONSE" | jq -r '.preview_token // .post.preview_token // empty')
SITE_DOMAIN=$(echo "$RESPONSE" | jq -r '.site.domain // empty')

# If no site domain in response, fetch from base URL
if [[ -z "$SITE_DOMAIN" ]]; then
  SITE_DOMAIN="${BLACKOPS_BASE_URL#https://}"
  SITE_DOMAIN="${SITE_DOMAIN#http://}"
  SITE_DOMAIN="${SITE_DOMAIN%%/*}"
fi

# Output the full JSON response
echo "$RESPONSE"

# Show appropriate URL based on status
if [[ -n "$POST_SLUG" ]]; then
  if [[ "$POST_STATUS" == "published" ]]; then
    PUBLISHED_URL="https://${SITE_DOMAIN}/blog/${POST_SLUG}"
    echo "" >&2
    echo "✓ Post published" >&2
    echo "Live URL: $PUBLISHED_URL" >&2
  elif [[ -n "$PREVIEW_TOKEN" ]]; then
    PREVIEW_URL="https://${SITE_DOMAIN}/blog/${POST_SLUG}?preview=${PREVIEW_TOKEN}"
    echo "" >&2
    echo "✓ Post updated: $POST_STATUS" >&2
    echo "Preview: $PREVIEW_URL" >&2
  else
    echo "" >&2
    echo "✓ Post updated: $POST_STATUS" >&2
  fi
fi
