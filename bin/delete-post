#!/usr/bin/env bash
set -euo pipefail

# Delete a post

if [[ $# -eq 0 ]] || [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
  cat <<EOF
Delete a blog post

Usage:
  blackops-center delete-post <post-id>

Warning: This is permanent and cannot be undone.

Examples:
  blackops-center delete-post abc123-def456-789
EOF
  exit 0
fi

POST_ID="$1"

curl -s -X DELETE \
  -H "Authorization: Bearer ${BLACKOPS_API_TOKEN}" \
  -H "Content-Type: application/json" \
  "${BLACKOPS_BASE_URL}/api/ext/posts/${POST_ID}"
